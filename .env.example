# WebPageTest API Key
# Get your key at: https://www.webpagetest.org/getkey.php
WPT_API_KEY=your-api-key-here

# Chrome UX Report (CrUX) API Key
# Uses PageSpeed Insights API — same key works
# Get your key at: https://developers.google.com/speed/docs/insights/v5/get-started
CRUX_API_KEY=your-api-key-here
